find_package(Git QUIET)
set(FCITX_BUILD_ORIGIN "Unavailable (origin not found)")
set(FCITX_BUILD_COMMIT "Unavailable")
set(FCITX_BUILD_COMMIT_TIME "Unavailable")
if(GIT_FOUND)
    foreach(field IN ITEMS ORIGIN COMMIT COMMIT_TIME)
        if(field STREQUAL "ORIGIN")
            set(arguments remote get-url origin)
        elseif(field STREQUAL "COMMIT")
            set(arguments rev-parse --short=12 HEAD)
        else()
            set(arguments show -s --format=%cI HEAD)
        endif()
        execute_process(COMMAND "${GIT_EXECUTABLE}" ${arguments}
            WORKING_DIRECTORY "${CMAKE_CURRENT_LIST_DIR}/../.."
            RESULT_VARIABLE result OUTPUT_VARIABLE value
            OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
        if(result EQUAL 0 AND NOT value STREQUAL "")
            set(FCITX_BUILD_${field} "${value}")
        endif()
    endforeach()
endif()
set(FCITX_BUILD_HOMEPAGE "${FCITX_BUILD_ORIGIN}")
if(FCITX_BUILD_HOMEPAGE MATCHES "^[^@]+@([^:]+):(.+)$")
    set(FCITX_BUILD_HOMEPAGE "https://${CMAKE_MATCH_1}/${CMAKE_MATCH_2}")
elseif(FCITX_BUILD_HOMEPAGE MATCHES "^ssh://([^@/]+@)?([^/]+)/(.+)$")
    set(FCITX_BUILD_HOMEPAGE "https://${CMAKE_MATCH_2}/${CMAKE_MATCH_3}")
endif()
string(REGEX REPLACE "\\.git$" "" FCITX_BUILD_HOMEPAGE "${FCITX_BUILD_HOMEPAGE}")
set(FCITX_BUILD_CI "")
if("$ENV{GITHUB_ACTIONS}" STREQUAL "true" AND NOT "$ENV{GITHUB_RUN_NUMBER}" STREQUAL "")
    set(FCITX_BUILD_CI "$ENV{GITHUB_RUN_NUMBER}")
endif()
foreach(field IN ITEMS ORIGIN HOMEPAGE COMMIT COMMIT_TIME CI)
    string(REPLACE "\\" "\\\\" FCITX_BUILD_${field} "${FCITX_BUILD_${field}}")
    string(REPLACE "\"" "\\\"" FCITX_BUILD_${field} "${FCITX_BUILD_${field}}")
    string(REPLACE "\r" "\\r" FCITX_BUILD_${field} "${FCITX_BUILD_${field}}")
    string(REPLACE "\n" "\\n" FCITX_BUILD_${field} "${FCITX_BUILD_${field}}")
endforeach()
configure_file("${CMAKE_CURRENT_LIST_DIR}/buildinfo.h.in" "${OUTPUT_DIR}/buildinfo.h" @ONLY)
