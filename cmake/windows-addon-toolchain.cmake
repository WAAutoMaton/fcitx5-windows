include("${CMAKE_CURRENT_LIST_DIR}/pinyin-toolchain.cmake")
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES
    FCITX5_WINDOWS_SDK WINDOWS_DEPENDENCY_PREFIX)
if(NOT FCITX5_WINDOWS_SDK OR NOT IS_ABSOLUTE "${FCITX5_WINDOWS_SDK}")
    message(FATAL_ERROR "Set FCITX5_WINDOWS_SDK to the absolute Core SDK prefix")
endif()
list(PREPEND CMAKE_FIND_ROOT_PATH "${FCITX5_WINDOWS_SDK}")
list(PREPEND CMAKE_PREFIX_PATH "${FCITX5_WINDOWS_SDK}")
