+const Configuration *PinyinEngine::getSubConfig(const std::string &path) const {
+    if (path != "windows-dictionaries") {
+        return nullptr;
+    }
+    std::vector<std::string> paths, states;
+    for (const auto &[file, state] : dictionaryStates_) {
+        const auto text = file.u8string();
+        paths.emplace_back(reinterpret_cast<const char *>(text.data()),
+                           text.size());
+        states.push_back(state);
+    }
+    dictionaryConfig_.paths.setValue(std::move(paths));
+    dictionaryConfig_.states.setValue(std::move(states));
+    return &dictionaryConfig_;
+}
