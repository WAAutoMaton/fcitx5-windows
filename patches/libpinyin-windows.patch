 #include <stdio.h>
+#ifdef _WIN32
+#include <string>
+#include <stdlib.h>
+#include <string.h>
+// The native Windows CRT does not provide POSIX getline.
+static ssize_t getline(char **buffer, size_t *capacity, FILE *input) {
+    std::string line;
+    int c;
+    while ((c = fgetc(input)) != EOF) {
+        line += static_cast<char>(c);
+        if (c == '\n') break;
+    }
+    if (line.empty()) return -1;
+    if (*capacity <= line.size()) {
+        auto *next = static_cast<char *>(realloc(*buffer, line.size() + 1));
+        if (!next) return -1;
+        *buffer = next;
+        *capacity = line.size() + 1;
+    }
+    memcpy(*buffer, line.c_str(), line.size() + 1);
+    return static_cast<ssize_t>(line.size());
+}
+#endif
 #include <locale.h>
 #include <glib.h>
 #include "pinyin_internal.h"
