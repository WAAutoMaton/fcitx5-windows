diff --git a/CMakeLists.txt b/CMakeLists.txt
index d8fd713..93f2451 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -26,9 +26,17 @@ if ("${Rime_VERSION}" VERSION_LESS "1.10.0")
     add_definitions(-DFCITX_RIME_NO_HIGHLIGHT_CANDIDATE)
 endif()
 
-if(NOT DEFINED RIME_DATA_DIR)
-  find_package(RimeData REQUIRED)
-endif(NOT DEFINED RIME_DATA_DIR)
+if (WIN32)
+  # Windows packages carry the schemas in the plugin prefix. Runtime lookup
+  # uses Fcitx5 StandardPaths so the installed tree remains relocatable.
+  set(RIME_DATA_DIR "")
+  set(RIME_DATA_INSTALL_DIR "${CMAKE_INSTALL_DATADIR}/rime-data")
+else()
+  if(NOT DEFINED RIME_DATA_DIR)
+    find_package(RimeData REQUIRED)
+  endif(NOT DEFINED RIME_DATA_DIR)
+  set(RIME_DATA_INSTALL_DIR "${RIME_DATA_DIR}")
+endif()
 message(STATUS "Precompiler macro RIME_DATA_DIR is set to \"${RIME_DATA_DIR}\"")
 add_definitions(-DRIME_DATA_DIR="${RIME_DATA_DIR}")
 add_definitions(-DFCITX_GETTEXT_DOMAIN=\"fcitx5-rime\")
