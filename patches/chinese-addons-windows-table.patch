--- a/im/table/ime.cpp
+++ b/im/table/ime.cpp
@@ -140,6 +140,15 @@ TableIME::requestDict(const std::string &name) {
             auto dictFile = StandardPaths::global().open(
                 StandardPathsType::PkgData, *root.config->file);
             TABLE_DEBUG() << "Load table at: " << *root.config->file;
+#ifdef _WIN32
+            // Built-in table paths contain the build prefix. Prefer the
+            // deployed data tree so moved Windows installations stay usable.
+            auto deployed = StandardPaths::global().open(
+                StandardPathsType::Data,
+                std::filesystem::path("libime") /
+                    std::filesystem::path(*root.config->file).filename());
+            if (deployed.isValid()) { dictFile = std::move(deployed); }
+#endif
             if (!dictFile.isValid()) {
                 throw std::runtime_error("Couldn't open file");
             }
