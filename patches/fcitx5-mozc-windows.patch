--- /dev/null
+++ b/src/win32_compat.cc
@@ -0,0 +1,74 @@
+#ifdef _WIN32
+
+#include <windows.h>
+#include <sddl.h>
+#include <shlobj.h>
+
+#include <optional>
+#include <string>
+#include <string_view>
+
+#include "absl/base/no_destructor.h"
+#include "base/win32/wide_char.h"
+#include "base/win32/win_sandbox.h"
+#include "base/win32/win_util.h"
+
+namespace mozc {
+namespace {
+
+std::optional<std::string> GetFolderUtf8(int csidl) {
+  wchar_t path[MAX_PATH] = {};
+  if (FAILED(::SHGetFolderPathW(nullptr, csidl, nullptr, SHGFP_TYPE_CURRENT,
+                                path))) {
+    return std::nullopt;
+  }
+  return win32::WideToUtf8(path);
+}
+
+}  // namespace
+
+const std::optional<std::wstring>& WinUtil::GetSystem32Path() {
+  static const absl::NoDestructor<std::optional<std::wstring>> kSystem32Path(
+      []() -> std::optional<std::wstring> {
+        wchar_t path[MAX_PATH] = {};
+        const UINT len = ::GetSystemDirectoryW(path, MAX_PATH);
+        if (len == 0 || len >= MAX_PATH) {
+          return std::nullopt;
+        }
+        return std::wstring(path, len);
+      }());
+  return *kSystem32Path;
+}
+
+const std::optional<std::string>& WinUtil::GetProgramFilesX86Path() {
+  static const absl::NoDestructor<std::optional<std::string>> kProgramFilesPath(
+      GetFolderUtf8(CSIDL_PROGRAM_FILESX86));
+  return *kProgramFilesPath;
+}
+
+const std::optional<std::string>& WinUtil::GetLocalAppDataPath() {
+  static const absl::NoDestructor<std::optional<std::string>> kLocalAppDataPath(
+      GetFolderUtf8(CSIDL_LOCAL_APPDATA));
+  return *kLocalAppDataPath;
+}
+
+wil::unique_hlocal_security_descriptor WinSandbox::MakeSecurityDescriptor(
+    ObjectSecurityType /*shareble_object_type*/) {
+  PSECURITY_DESCRIPTOR sd = nullptr;
+  // Grant access to SYSTEM, Administrators, and the current object owner.
+  if (!::ConvertStringSecurityDescriptorToSecurityDescriptorW(
+          L"D:(A;;GA;;;SY)(A;;GA;;;BA)(A;;GA;;;OW)", SDDL_REVISION_1, &sd,
+          nullptr)) {
+    return nullptr;
+  }
+  return wil::unique_hlocal_security_descriptor(sd);
+}
+
+bool WinSandbox::EnsureAllApplicationPackagesPermisssion(
