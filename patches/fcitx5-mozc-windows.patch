+#ifndef FCITX5_MOZC_WIN32_COMPAT_WIL_RESOURCE_H_
+#define FCITX5_MOZC_WIN32_COMPAT_WIL_RESOURCE_H_
+
+#include <windows.h>
+
+#include <cstddef>
+#include <utility>
+
+namespace wil {
+
+template <typename HandleT, bool AllowInvalidHandleValue, typename CloseFn,
+          CloseFn Close>
+class unique_win32_handle {
+ public:
+  constexpr unique_win32_handle() noexcept = default;
+  constexpr unique_win32_handle(std::nullptr_t) noexcept {}
+  explicit unique_win32_handle(HandleT handle) noexcept : handle_(handle) {}
+
+  unique_win32_handle(const unique_win32_handle&) = delete;
+  unique_win32_handle& operator=(const unique_win32_handle&) = delete;
+
+  unique_win32_handle(unique_win32_handle&& other) noexcept
+      : handle_(other.release()) {}
+
+  unique_win32_handle& operator=(unique_win32_handle&& other) noexcept {
+    if (this != &other) {
+      reset(other.release());
+    }
+    return *this;
+  }
+
+  unique_win32_handle& operator=(std::nullptr_t) noexcept {
+    reset();
+    return *this;
+  }
+
+  ~unique_win32_handle() { reset(); }
+
+  HandleT get() const noexcept { return handle_; }
+
+  bool is_valid() const noexcept {
+    if (handle_ == nullptr) {
+      return false;
+    }
+    if constexpr (!AllowInvalidHandleValue) {
+      return handle_ != INVALID_HANDLE_VALUE;
+    }
+    return true;
+  }
+
+  explicit operator bool() const noexcept { return is_valid(); }
+
+  HandleT release() noexcept {
+    HandleT old = handle_;
+    handle_ = nullptr;
+    return old;
+  }
+
+  void reset(HandleT handle = nullptr) noexcept {
+    if (is_valid()) {
+      Close(handle_);
+    }
+    handle_ = handle;
+  }
+
+ private:
+  HandleT handle_ = nullptr;
+};
+
+using unique_handle =
+    unique_win32_handle<HANDLE, false, decltype(&::CloseHandle), &::CloseHandle>;
+using unique_hfile =
+    unique_win32_handle<HANDLE, false, decltype(&::CloseHandle), &::CloseHandle>;
+using unique_process_handle =
+    unique_win32_handle<HANDLE, false, decltype(&::CloseHandle), &::CloseHandle>;
+using unique_hlocal_security_descriptor =
+    unique_win32_handle<PSECURITY_DESCRIPTOR, true, decltype(&::LocalFree),
+                        &::LocalFree>;
+
+}  // namespace wil
